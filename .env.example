# ============================================================
# 簽名 AI Agent 環境變數範本
# 使用方法：
#   1. 複製本檔案為 .env
#      cp .env.example .env
#   2. 用編輯器打開 .env，填入你的真實 API Key
#   3. 儲存後直接 python3 app.py 即可，不用每次 export
# ============================================================

# ---------- 必填 ----------
# OpenAI 用 sk- 開頭的 key
# xAI 用 xai- 開頭的 key
OPENAI_API_KEY=sk-請替換成你的真實key

# ---------- 可選（有預設值） ----------
# 模型名稱
# OpenAI 推薦：gpt-4o 或 gpt-4o-mini
# xAI 推薦：grok-2-vision-1212
OPENAI_MODEL=gpt-4o

# API 端點
# OpenAI 預設：https://api.openai.com/v1
# xAI 請改成：https://api.x.ai/v1
OPENAI_BASE_URL=https://api.openai.com/v1

# 也支援用 XAI_API_KEY（與 OPENAI_API_KEY 二選一即可）
# XAI_API_KEY=xai-xxxxxxxx
